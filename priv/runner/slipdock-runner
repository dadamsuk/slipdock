#!/bin/sh
# slipdock-runner — takes jobs from a Slipdock board's runner queue and runs
# them on this machine. Needs sh and curl, nothing else.
#
#   slipdock-runner                  run until stopped
#   slipdock-runner --once           take at most one job, then exit
#   slipdock-runner --config=FILE    another config than the default
#
# What runs is decided here, never by the server: a job arrives as an id, a
# kind, a card and a prompt, and the config's job_<kind> function says what
# that kind means. A kind the config has no function for is refused, and
# nothing runs. The prompt only ever reaches a job as $SLIPDOCK_PROMPT.
#
# The config (default ~/.config/slipdock-runner/config) is sourced: it sets
# SLIPDOCK_URL and SLIPDOCK_RUNNER_TOKEN, optionally POOL, WAIT, HEARTBEAT,
# JOB_TIMEOUT, GRACE and JOB_INSTRUCTIONS (appended to every prompt), and
# defines the job_<kind> functions — and, if it likes, before_job (a job runs
# only if it succeeds) and after_job (always, with SLIPDOCK_EXIT and
# SLIPDOCK_STATUS: done, failed, cancelled or timeout).
#
# Lanes, off unless the config sets WORKTREE=1: each job runs in a git
# worktree of its own, on a branch named for its card (card-<id>), so jobs
# side by side never share a working tree. WORKTREE_REPO is the repository
# (default: the directory the runner started in), WORKTREE_DIR where the
# worktrees go (default: <repo>-lanes beside it). A clean worktree is removed
# after the job; one with uncommitted changes is kept, and the job's log says so.
#
# Built in: the merge kind (#1656), for boards that ship by pull request.
# Accepting a card there queues a merge job, and this runner merges the
# card's pull request, needing git and a signed-in gh (GitHub CLI), run in
# the runner's repository: WORKTREE_REPO, else WORKDIR, else the directory
# the runner started in (#1666). It merges only a pull request in that
# repository's origin, still open, whose head is the commit that was
# accepted, and reports the merge commit. MERGE=0 in the config turns it off;
# a config's own job_merge replaces it. Every claim tells the server which
# kinds this runner takes, so merge jobs only come to runners that can.
#
# Keeping current (#1658), off unless the config sets SELF_UPDATE=1 (new
# installs do): every claim says which script this is (its own SHA-256), and
# the server answers with the one it hands out. When they differ and a claim
# came back empty, so no job is running, the runner fetches the script and
# SHA256SUMS from the server (or SELF_UPDATE_URL), and replaces itself only
# if the download's SHA-256 matches both; then it starts again in place. A
# mismatch keeps this script, says so in the log, and isn't tried again. The
# config is never touched.
#
# Live log (#1870): while a job runs, the runner sends its agent's Claude
# Code transcript to the server about every TRANSCRIPT_EVERY seconds
# (default 60; 0 turns it off), and once more as the job ends, so the job
# can be watched from the board. The transcript is the newest .jsonl under
# TRANSCRIPTS (default ~/.claude/projects, one level of project folders)
# written since the job started that mentions the card's link. Each send is
# the lines the server hasn't got, at most TRANSCRIPT_SEND bytes (default
# 524288), any line over TRANSCRIPT_LINE bytes (default 32768) replaced by
# a line saying how long it was, and this machine's Slipdock tokens taken
# out: the runner's, $SLIPDOCK_TOKEN and the slipdock CLI's saved ones. A
# send that fails never stops the job; the next one catches up.
#
# Drift (#1795): every claim also says the SHA-256 of each slipdock skill
# installed under SKILLS_DIR (default ~/.claude/skills) and of the slipdock
# CLI (SLIPDOCK_CLI, else the one on the PATH), and the runners list shows
# any that differ from the server's. Nothing is changed on this machine.
set -u

# The built-in merge (see above). The server sends only data: the pull
# request's URL and the accepted commit, both checked here before use.
job_merge() {
  pr=${SLIPDOCK_MERGE_PR:-}
  want=${SLIPDOCK_MERGE_COMMIT:-}
  [ -n "$pr" ] || { echo "merge: the card names no pull request (its evidence has no PR URL)"; return 2; }
  [ -n "$want" ] || { echo "merge: the card names no accepted commit"; return 2; }
  num=$(printf '%s\n' "$pr" | sed -n 's#^https://github\.com/\([A-Za-z0-9_.-]*/[A-Za-z0-9_.-]*\)/pull/\([0-9][0-9]*\)/*$#\2#p')
  prrepo=$(printf '%s\n' "$pr" | sed -n 's#^https://github\.com/\([A-Za-z0-9_.-]*/[A-Za-z0-9_.-]*\)/pull/\([0-9][0-9]*\)/*$#\1#p')
  [ -n "$num" ] || { echo "merge: $pr is not a GitHub pull request URL"; return 2; }
  command -v git >/dev/null 2>&1 || { echo "merge: git is not installed"; return 2; }
  command -v gh >/dev/null 2>&1 || { echo "merge: gh (GitHub CLI) is not installed"; return 2; }
  origin=$(git remote get-url origin 2>/dev/null) || { echo "merge: $PWD has no origin remote"; return 2; }
  repo=$(printf '%s\n' "$origin" | sed -e 's#\.git$##' -e 's#/*$##' -e 's#^git@github\.com:##' \
    -e 's#^ssh://git@github\.com/##' -e 's#^https://\([^@/]*@\)\{0,1\}github\.com/##')
  lower() { printf '%s' "$1" | tr 'A-Z' 'a-z'; }
  [ "$(lower "$repo")" = "$(lower "$prrepo")" ] || {
    echo "merge: the pull request is in $prrepo, but this runner's repository is $origin; nothing merged"
    return 2
  }
  gh auth status >/dev/null 2>&1 || { echo "merge: gh is not signed in (run gh auth login)"; return 2; }
  info=$(gh pr view "$num" --repo "$prrepo" --json state,headRefOid --jq '.state + " " + .headRefOid' 2>&1) || {
    echo "merge: could not read $pr: $info"
    return 2
  }
  state=${info%% *}
  head=${info#* }
  [ "$state" = OPEN ] || { echo "merge: $pr is $state, not open; nothing merged"; return 2; }
  case "$want" in *[!0-9a-fA-F]*) echo "merge: the accepted commit $want is not a commit id"; return 2 ;; esac
  case "$(lower "$head")" in
    "$(lower "$want")"*) ;;
    *)
      echo "merge: $pr's head is $head, not the accepted commit $want (it moved after the card was accepted); nothing merged"
      return 2
      ;;
  esac
  # gh's own words are the reason (#1666): a conflict reads differently from
  # a failing check or branch protection, and only a conflict wants a rebase.
  said=$(gh pr merge "$num" --repo "$prrepo" --merge --match-head-commit "$head" \
    --subject "Merge PR $num: card #${SLIPDOCK_CARD:-?}" 2>&1) || {
    said=$(printf '%s' "$said" | tr '\r\n\t' '   ' | sed -e 's/   */ /g' -e 's/  */ /g' -e 's/^ //' -e 's/ $//')
    echo "merge: gh pr merge refused $pr: ${said:-gh gave no reason}"
    return 3
  }
  [ -z "$said" ] || printf '%s\n' "$said"
  sha=$(gh pr view "$num" --repo "$prrepo" --json mergeCommit --jq '.mergeCommit.oid' 2>/dev/null)
  echo "merge: merged $pr (head $head) as ${sha:-an unknown commit}"
  [ -n "${SLIPDOCK_MERGED_FILE:-}" ] && printf '%s\n' "$sha" >"$SLIPDOCK_MERGED_FILE"
  return 0
}

CONFIG=${SLIPDOCK_RUNNER_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/slipdock-runner/config}
ONCE=
for arg in "$@"; do
  case "$arg" in
    --once) ONCE=1 ;;
    --config=*) CONFIG=${arg#--config=} ;;
    -h | --help)
      # The whole header: every comment line from the second to the first code.
      awk 'NR > 1 && /^#/ { print; next } NR > 1 { exit }' "$0"
      exit 0
      ;;
    *)
      echo "slipdock-runner: unknown option $arg" >&2
      exit 2
      ;;
  esac
done

say() { printf '%s slipdock-runner: %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >&2; }

[ -r "$CONFIG" ] || {
  say "no config at $CONFIG"
  exit 2
}
# shellcheck disable=SC1090
. "$CONFIG"

: "${SLIPDOCK_URL:?the config must set SLIPDOCK_URL}"
: "${SLIPDOCK_RUNNER_TOKEN:?the config must set SLIPDOCK_RUNNER_TOKEN}"
SLIPDOCK_URL=${SLIPDOCK_URL%/}
POOL=${POOL:-}
WAIT=${WAIT:-25}
HEARTBEAT=${HEARTBEAT:-20}
JOB_TIMEOUT=${JOB_TIMEOUT:-3600}
GRACE=${GRACE:-10}
LOG_TAIL=${LOG_TAIL:-8000}
TRANSCRIPT_EVERY=${TRANSCRIPT_EVERY:-60}
TRANSCRIPTS=${TRANSCRIPTS:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects}
TRANSCRIPT_SEND=${TRANSCRIPT_SEND:-524288}
TRANSCRIPT_LINE=${TRANSCRIPT_LINE:-32768}
case "$TRANSCRIPT_EVERY" in '' | *[!0-9]*) TRANSCRIPT_EVERY=0 ;; esac
case "$TRANSCRIPT_SEND" in '' | *[!0-9]* | 0) TRANSCRIPT_SEND=524288 ;; esac
case "$TRANSCRIPT_LINE" in '' | *[!0-9]* | 0) TRANSCRIPT_LINE=32768 ;; esac
case "${MERGE:-}" in 0 | no | false | off) unset -f job_merge ;; esac

command -v curl >/dev/null 2>&1 || {
  say "curl is needed and was not found"
  exit 2
}

WORK=$(mktemp -d "${TMPDIR:-/tmp}/slipdock-runner.XXXXXX") || exit 1
chmod 700 "$WORK"
# The token reaches curl in a file, never on its command line, where anybody
# on the machine could read it with ps.
(umask 077 && printf 'Authorization: Bearer %s\n' "$SLIPDOCK_RUNNER_TOKEN" >"$WORK/auth")

# A function the config defines answers `command -v` with its bare name;
# anything else (nothing, or a program of that name on the PATH) does not.
defined() { [ "$(command -v "$1" 2>/dev/null)" = "$1" ]; }

# The kinds this runner takes, said on every claim (X-Runner-Kinds): every
# job_<kind> function the config defines, and the built-in merge.
KINDS=$({ grep -o 'job_[a-z0-9_]*' "$CONFIG" 2>/dev/null; echo job_merge; } | sort -u |
  while read -r f; do defined "$f" && printf '%s\n' "${f#job_}"; done | paste -s -d , -)
# sha256 FILE — the file's SHA-256 in hex, with whichever tool is here.
sha256() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  elif command -v openssl >/dev/null 2>&1; then
    openssl dgst -sha256 "$1" | awk '{print $NF}'
  fi
}

# Which script this is, said on every claim (#1658).
SELF=$0
MY_SHA=$(sha256 "$SELF" 2>/dev/null)

# What this machine has installed, said on every claim (#1795): the SHA-256
# of each slipdock skill's SKILL.md under SKILLS_DIR (default
# ~/.claude/skills) and of the slipdock CLI (SLIPDOCK_CLI, else the one on
# the PATH). The server says when they differ from what it serves; it never
# changes them.
SKILLS_DIR=${SKILLS_DIR:-$HOME/.claude/skills}
installed_skills() {
  list=
  for f in "$SKILLS_DIR"/slipdock*/SKILL.md; do
    [ -f "$f" ] || continue
    name=$(basename "$(dirname "$f")")
    s=$(tr -d '\r' <"$f" >"$WORK/skill" && sha256 "$WORK/skill" 2>/dev/null)
    [ -n "$s" ] && list="$list${list:+,}$name=$s"
  done
  printf '%s' "${list:-none}"
}
installed_cli() {
  cli=${SLIPDOCK_CLI:-$(command -v slipdock 2>/dev/null)}
  if [ -n "$cli" ] && [ -f "$cli" ]; then sha256 "$cli" 2>/dev/null; else printf none; fi
}

# The claim's headers, written again before each claim: a skill edited while
# the runner waits is reported on the next one.
claim_headers() {
  {
    printf 'X-Runner-Kinds: %s\n' "$KINDS"
    case "$MY_SHA" in ?*) printf 'X-Runner-Version: sh %s\n' "$MY_SHA" ;; esac
    printf 'X-Runner-Skills: %s\n' "$(installed_skills)"
    cli_sha=$(installed_cli)
    case "$cli_sha" in ?*) printf 'X-Runner-CLI: %s\n' "$cli_sha" ;; esac
  } >"$WORK/kinds"
}
SKIP_SHA=

# self_update LATEST — between jobs: fetch the script and its checksums, and
# put the script in place of this one only if its SHA-256 matches both the
# published sum and LATEST. 0 when it was replaced.
self_update() {
  base=${SELF_UPDATE_URL:-$SLIPDOCK_URL/runner}
  base=${base%/}
  if ! curl -fsS --max-time 60 -o "$WORK/new" "$base/slipdock-runner" 2>>"$WORK/curl.err" ||
    ! curl -fsS --max-time 60 -o "$WORK/sums" "$base/SHA256SUMS" 2>>"$WORK/curl.err"; then
    say "self-update: could not fetch the new script from $base; keeping this one"
    return 1
  fi
  got=$(sha256 "$WORK/new")
  published=$(awk '$2 == "slipdock-runner" {print $1}' "$WORK/sums")
  if [ -z "$got" ] || [ "$got" != "$published" ] || [ "$got" != "$1" ]; then
    say "self-update: checksum mismatch (got ${got:-none}, published ${published:-none}, expected $1); keeping this script"
    return 1
  fi
  cp "$WORK/new" "$SELF.new" && chmod 755 "$SELF.new" && mv "$SELF.new" "$SELF" || {
    say "self-update: could not replace $SELF; keeping this script"
    rm -f "$SELF.new"
    return 1
  }
  say "self-update: replaced $SELF (${MY_SHA:-?} -> $got)"
  return 0
}

JOB_PID=
JOB_ID=
CODE=
LANE=
LANE_REPO=
LANE_BRANCH=

# A runner told to stop takes its job down with it and says nothing to the
# server: the lease runs out and the job goes back in the queue for another.
shutdown() {
  [ -n "$JOB_PID" ] && stop_job
  rm -rf "$WORK"
  exit "$1"
}
trap 'shutdown 130' INT
trap 'shutdown 143' TERM
trap 'rm -rf "$WORK"' EXIT

# post PATH BODY_FILE MAX_SECONDS [HEADER_FILE] — sets CODE to the HTTP status
# (000 when nothing answered); the body lands in $WORK/resp and the headers in
# $WORK/hdr.
post() {
  CODE=$(curl -sS -o "$WORK/resp" -D "$WORK/hdr" -w '%{http_code}' -X POST \
    -H @"$WORK/auth" -H @"${4:-/dev/null}" -H 'Content-Type: text/plain' --max-time "$3" \
    --data-binary @"$2" "$SLIPDOCK_URL$1" 2>>"$WORK/curl.err") || CODE=000
  [ -n "$CODE" ] || CODE=000
}

# header NAME — one response header's value, NAME in lower case.
header() {
  awk -v n="$1" '{
    i = index($0, ":"); if (i == 0) next
    if (tolower(substr($0, 1, i - 1)) == n) {
      v = substr($0, i + 1); sub(/^[ \t]+/, "", v); sub(/\r$/, "", v); print v; exit
    }
  }' "$WORK/hdr"
}

# descendants PID — every process below PID, however deep. Taken from ps,
# which Linux and macOS both have, because neither `setsid` (no macOS) nor
# job control (dash refuses it without a terminal) is there everywhere.
descendants() {
  ps -A -o pid= -o ppid= 2>/dev/null | awk -v root="$1" '
    { parent[$1] = $2 }
    END {
      found[root] = 1
      more = 1
      while (more) {
        more = 0
        for (p in parent) if (!(p in found) && (parent[p] in found)) { found[p] = 1; more = 1 }
      }
      for (p in found) if (p != root) print p
    }'
}

# Stops the job and everything it started: the whole tree is read before
# any of it is signalled, since a child whose parent dies is lost to init.
stop_job() {
  tree="$(descendants "$JOB_PID") $JOB_PID"
  # shellcheck disable=SC2086
  kill -TERM $tree 2>/dev/null
  i=0
  while [ ! -e "$WORK/rc" ] && kill -0 "$JOB_PID" 2>/dev/null && [ "$i" -lt "$GRACE" ]; do
    sleep 1
    i=$((i + 1))
  done
  tree="$tree $(descendants "$JOB_PID")"
  # shellcheck disable=SC2086
  kill -KILL $tree 2>/dev/null
  wait "$JOB_PID" 2>/dev/null
  JOB_PID=
}

# after_job EXIT STATUS — the config's after_job, if it has one, whatever
# happened to the job. Its output goes in the job's log.
run_after_job() {
  defined after_job || return 0
  SLIPDOCK_EXIT=$1
  SLIPDOCK_STATUS=$2
  export SLIPDOCK_EXIT SLIPDOCK_STATUS
  (cd "${LANE:-${JOB_DIR:-.}}" && after_job) >>"$WORK/log" 2>&1 </dev/null || say "job #$JOB_ID: after_job failed (exit $?)"
}

# lane_open CARD — with WORKTREE on, makes (or reuses) the card's worktree and
# sets LANE to it; the job, before_job and after_job run there. Off, or with
# no card or no repository, LANE stays empty and the job runs in place, which
# the log says. Fails only when the worktree can't be made: the job then
# doesn't run, since running it in the shared tree is what the setting is for.
lane_open() {
  LANE=
  case "${WORKTREE:-}" in '' | 0 | no | false | off) return 0 ;; esac
  repo=${WORKTREE_REPO:-$PWD}
  if [ -z "$1" ]; then
    echo "slipdock-runner: the job has no card, so no worktree; it runs in $PWD" >>"$WORK/log"
    return 0
  fi
  if ! command -v git >/dev/null 2>&1 || ! top=$(git -C "$repo" rev-parse --show-toplevel 2>/dev/null); then
    echo "slipdock-runner: $repo is not a git repository, so no worktree; the job runs in $PWD" >>"$WORK/log"
    return 0
  fi
  branch=card-$1
  path=${WORKTREE_DIR:-$top-lanes}/$branch
  if [ -d "$path" ]; then
    git -C "$path" rev-parse --git-dir >/dev/null 2>&1 || {
      echo "slipdock-runner: $path is there but is not a worktree, so the job was not run" >>"$WORK/log"
      return 1
    }
    echo "slipdock-runner: worktree $path (kept from before) on $(git -C "$path" rev-parse --abbrev-ref HEAD 2>/dev/null)" >>"$WORK/log"
  else
    if git -C "$top" show-ref --verify --quiet "refs/heads/$branch"; then
      git -C "$top" worktree add "$path" "$branch" >>"$WORK/log" 2>&1
    else
      git -C "$top" worktree add -b "$branch" "$path" HEAD >>"$WORK/log" 2>&1
    fi || {
      echo "slipdock-runner: could not make worktree $path, so the job was not run" >>"$WORK/log"
      return 1
    }
    echo "slipdock-runner: worktree $path on branch $branch" >>"$WORK/log"
  fi
  LANE=$path
  LANE_REPO=$top
  LANE_BRANCH=$branch
  SLIPDOCK_WORKTREE=$path
  export SLIPDOCK_WORKTREE
}

# lane_close — after the job: a clean worktree is removed, and its branch
# deleted if it is merged (git branch -d); anything uncommitted keeps it.
lane_close() {
  [ -n "$LANE" ] || return 0
  if [ -n "$(git -C "$LANE" status --porcelain 2>/dev/null)" ]; then
    echo "slipdock-runner: worktree $LANE has uncommitted changes, so it is kept" >>"$WORK/log"
  elif git -C "$LANE_REPO" worktree remove "$LANE" >>"$WORK/log" 2>&1; then
    if git -C "$LANE_REPO" branch -d "$LANE_BRANCH" >/dev/null 2>&1; then
      echo "slipdock-runner: worktree $LANE removed" >>"$WORK/log"
    else
      echo "slipdock-runner: worktree $LANE removed; branch $LANE_BRANCH kept (not merged)" >>"$WORK/log"
    fi
  else
    echo "slipdock-runner: could not remove worktree $LANE, so it is kept" >>"$WORK/log"
  fi
  LANE=
  unset SLIPDOCK_WORKTREE
}

# The live log (#1870). TX is the job's transcript once found, TX_LINES the
# lines the server holds, TX_DONE set once it says the log is full.
TX=
TX_LINES=0
TX_DONE=
TX_FAILED=

# scrub_list — this machine's Slipdock tokens, as a sed script in $WORK
# (never on a command line, where ps shows it), read again for each job.
scrub_list() {
  {
    printf '%s\n' "$SLIPDOCK_RUNNER_TOKEN" "${SLIPDOCK_TOKEN:-}"
    # The CLI keeps them in ~/.config/slipdock; XDG_CONFIG_HOME too, if set.
    for cfg in "$HOME/.config/slipdock" ${XDG_CONFIG_HOME:+"$XDG_CONFIG_HOME/slipdock"}; do
      for f in "$cfg/token" "$cfg"/tokens/*; do [ -f "$f" ] && cat "$f" && echo; done
    done
  } 2>/dev/null | tr -d '\r' | grep -E '^[A-Za-z0-9_.~+/=-]{8,}$' | sort -u |
    sed -e 's/\./\\./g' -e 's/.*/s|&|[redacted]|g/' >"$WORK/scrub.sed"
}

# find_transcript — sets TX to the job's transcript: the newest .jsonl in a
# folder under TRANSCRIPTS, written since the job started, that mentions the
# card's link. Kept once found.
find_transcript() {
  [ -n "$TX" ] && return 0
  [ -n "${SLIPDOCK_CARD_URL:-}" ] && [ -d "$TRANSCRIPTS" ] || return 1
  found=$(find "$TRANSCRIPTS" -maxdepth 2 -name '*.jsonl' -newer "$WORK/started" 2>/dev/null)
  [ -n "$found" ] || return 1
  # shellcheck disable=SC2086
  for f in $(ls -t $found 2>/dev/null); do
    if grep -qF "$SLIPDOCK_CARD_URL" "$f" 2>/dev/null; then
      TX=$f
      echo "slipdock-runner: sending the transcript $TX as the job's live log" >>"$WORK/log"
      return 0
    fi
  done
  return 1
}

# send_transcript [final] — sends the transcript's lines the server hasn't
# got. Each send is whole lines from TX_LINES, and the server's answer says
# where the next starts. A failed send is left for the next; at the end
# (final) it sends until caught up, trying a failed send three more times.
send_transcript() {
  [ "$TRANSCRIPT_EVERY" -gt 0 ] && [ -z "$TX_DONE" ] || return 0
  find_transcript || return 0
  rounds=2
  retry=0
  [ -n "${1:-}" ] && rounds=50
  while [ "$rounds" -gt 0 ]; do
    rounds=$((rounds - 1))
    # Whole lines only: one still being written waits for the next send.
    total=$(wc -l <"$TX" 2>/dev/null | tr -d ' ')
    case "$total" in '' | *[!0-9]*) return 0 ;; esac
    [ "$total" -gt "$TX_LINES" ] || return 0
    sed -n "$((TX_LINES + 1)),${total}p" "$TX" |
      LC_ALL=C awk -v max="$TRANSCRIPT_SEND" -v cut="$TRANSCRIPT_LINE" '{
        n = length($0)
        if (n > cut) $0 = "{\"type\":\"slipdock_cut\",\"bytes\":" n ",\"limit\":" cut "}"
        if (NR > 1 && size + length($0) + 1 > max) exit
        size += length($0) + 1
        print
      }' | sed -f "$WORK/scrub.sed" >"$WORK/tx" 2>/dev/null
    post "/api/runner/jobs/$JOB_ID/transcript?from=$TX_LINES" "$WORK/tx" 15
    word=
    n=
    read -r word n <"$WORK/resp" 2>/dev/null
    case "$n" in *[!0-9]*) n= ;; esac
    case "$CODE:$word" in
      200:ok | 409:from)
        TX_FAILED=
        [ -n "$n" ] && TX_LINES=$n
        ;;
      200:capped)
        echo "slipdock-runner: the server's log for this job is full; the rest of the transcript is not sent" >>"$WORK/log"
        TX_DONE=1
        return 0
        ;;
      *)
        [ -n "$TX_FAILED" ] || say "job #$JOB_ID: could not send the transcript (HTTP $CODE); trying again later"
        TX_FAILED=1
        # At the end there is no next send: a few more tries, a little apart.
        retry=$((retry + 1))
        [ -n "${1:-}" ] && [ "$retry" -le 3 ] || return 0
        sleep "$retry"
        ;;
    esac
  done
}

# finish EXIT STATUS — reports the job ended, with the tail of its log.
finish() {
  query="exit=$1"
  [ -n "$2" ] && query="$query&status=$2"
  merged=$(head -n 1 "$WORK/merged" 2>/dev/null)
  case "$merged" in '' | *[!0-9a-fA-F]*) ;; *) query="$query&merged=$merged" ;; esac
  tail -c "$LOG_TAIL" "$WORK/log" >"$WORK/tail" 2>/dev/null || : >"$WORK/tail"
  tries=0
  while :; do
    post "/api/runner/jobs/$JOB_ID/finish?$query" "$WORK/tail" 30
    case "$CODE" in 200 | 404) return 0 ;; esac
    tries=$((tries + 1))
    if [ "$tries" -ge 5 ]; then
      say "job #$JOB_ID: could not report it finished (HTTP $CODE)"
      return 1
    fi
    sleep $((tries * 2))
  done
}

run_job() {
  JOB_ID=$(header x-job-id)
  kind=$(header x-job-kind)
  card=$(header x-card-id)

  # These came from the server, so they are checked before anything uses them.
  case "$JOB_ID" in '' | *[!0-9]*)
    say "the server sent a job with no usable id"
    return
    ;;
  esac
  case "$card" in *[!0-9]*) card= ;; esac

  : >"$WORK/log"
  rm -f "$WORK/rc" "$WORK/rc.tmp" "$WORK/merged"
  # The live log's starting point: a transcript written after this is the job's.
  touch "$WORK/started"
  TX=
  TX_LINES=0
  TX_DONE=
  TX_FAILED=
  scrub_list

  fn=
  case "$kind" in
    '' | *[!a-z0-9_-]*) ;;
    *) fn=job_$(printf '%s' "$kind" | tr '-' '_') ;;
  esac

  if [ -z "$fn" ] || ! defined "$fn"; then
    say "job #$JOB_ID: no job_${kind} in $CONFIG — refused, nothing run"
    printf 'no such job kind: %s (this runner has no job_%s)\n' "$kind" "$kind" >"$WORK/log"
    finish 127 failed
    return
  fi

  SLIPDOCK_JOB_ID=$JOB_ID
  SLIPDOCK_JOB_KIND=$kind
  SLIPDOCK_CARD=$card
  SLIPDOCK_CARD_URL=$(header x-card-url)
  SLIPDOCK_PROMPT=$(cat "$WORK/resp")
  # A merge job's pull request and accepted commit (data, checked by job_merge).
  SLIPDOCK_MERGE_PR=$(header x-merge-pr)
  SLIPDOCK_MERGE_COMMIT=$(header x-merge-commit)
  SLIPDOCK_MERGED_FILE=$WORK/merged
  export SLIPDOCK_MERGE_PR SLIPDOCK_MERGE_COMMIT SLIPDOCK_MERGED_FILE
  # Standing instructions from this machine's config, after the card's own;
  # not for a verify job, whose agent checks the work rather than doing it.
  if [ -n "${JOB_INSTRUCTIONS:-}" ] && [ "$kind" != verify ] && [ "$kind" != merge ]; then
    SLIPDOCK_PROMPT="$SLIPDOCK_PROMPT

$JOB_INSTRUCTIONS"
  fi
  export SLIPDOCK_JOB_ID SLIPDOCK_JOB_KIND SLIPDOCK_CARD SLIPDOCK_CARD_URL SLIPDOCK_PROMPT

  say "job #$JOB_ID: $kind for card #$card"

  # A merge runs in the repository itself: its card's branch is the pull
  # request's, and nothing is built. That is the runner's repository wherever
  # the runner was started (systemd starts it in the home directory, #1666).
  LANE=
  JOB_DIR=.
  [ "$kind" = merge ] && JOB_DIR=${WORKTREE_REPO:-${WORKDIR:-.}}
  if [ "$kind" != merge ] && ! lane_open "$card"; then
    say "job #$JOB_ID: no worktree for it — job not run"
    run_after_job 1 failed
    finish 1 failed
    JOB_ID=
    return
  fi

  if defined before_job; then
    (cd "${LANE:-${JOB_DIR:-.}}" && before_job) >>"$WORK/log" 2>&1 </dev/null
    rc=$?
    if [ "$rc" -ne 0 ]; then
      say "job #$JOB_ID: before_job failed (exit $rc) — job not run"
      echo "slipdock-runner: before_job failed (exit $rc), so the job was not run" >>"$WORK/log"
      run_after_job "$rc" failed
      lane_close
      finish "$rc" failed
      JOB_ID=
      return
    fi
  fi

  # The inner subshell keeps an `exit` in the job from skipping the line
  # that records how it ended.
  (
    (cd "${LANE:-${JOB_DIR:-.}}" && "$fn") >>"$WORK/log" 2>&1 </dev/null
    echo $? >"$WORK/rc.tmp" && mv "$WORK/rc.tmp" "$WORK/rc"
  ) &
  JOB_PID=$!

  started=$(date +%s)
  last=0
  tx_last=$started
  # A merge runs no agent, so it has no transcript.
  [ "$kind" = merge ] && TX_DONE=1
  ended=
  while [ ! -e "$WORK/rc" ] && kill -0 "$JOB_PID" 2>/dev/null; do
    now=$(date +%s)
    if [ $((now - started)) -ge "$JOB_TIMEOUT" ]; then
      ended=timeout
      break
    fi
    if [ $((now - last)) -ge "$HEARTBEAT" ]; then
      last=$now
      tail -c "$LOG_TAIL" "$WORK/log" >"$WORK/tail"
      post "/api/runner/jobs/$JOB_ID/heartbeat" "$WORK/tail" 15
      case "$CODE" in
        200) [ "$(cat "$WORK/resp")" = cancel ] && ended=cancelled && break ;;
        # Not ours any more: the lease ran out and somebody else has it.
        404) ended=lost && break ;;
      esac
    fi
    if [ "$TRANSCRIPT_EVERY" -gt 0 ] && [ $((now - tx_last)) -ge "$TRANSCRIPT_EVERY" ]; then
      tx_last=$now
      send_transcript
    fi
    sleep 1
  done

  case "$ended" in
    timeout)
      say "job #$JOB_ID: over its ${JOB_TIMEOUT}s — stopped"
      stop_job
      echo "slipdock-runner: stopped after ${JOB_TIMEOUT}s" >>"$WORK/log"
      send_transcript final
      run_after_job 124 timeout
      lane_close
      finish 124 timeout
      ;;
    cancelled)
      say "job #$JOB_ID: cancelled from the board — stopped"
      stop_job
      echo "slipdock-runner: cancelled from the board" >>"$WORK/log"
      send_transcript final
      run_after_job 130 cancelled
      lane_close
      finish 130 cancelled
      ;;
    lost)
      say "job #$JOB_ID: no longer this runner's — stopped"
      stop_job
      run_after_job 130 cancelled
      lane_close
      ;;
    *)
      wait "$JOB_PID" 2>/dev/null
      JOB_PID=
      rc=$(cat "$WORK/rc" 2>/dev/null)
      case "$rc" in '' | *[!0-9]*) rc=1 ;; esac
      say "job #$JOB_ID: exit $rc"
      send_transcript final
      if [ "$rc" -eq 0 ]; then run_after_job 0 done; else run_after_job "$rc" failed; fi
      lane_close
      finish "$rc" ""
      ;;
  esac
  JOB_ID=
}

backoff=1
# Gateway errors in a row that were retried without a word.
quiet=0
query="wait=$WAIT"
[ -n "$POOL" ] && query="$query&pool=$POOL"
say "taking jobs from $SLIPDOCK_URL${POOL:+ (pool $POOL)}"

while :; do
  claim_headers
  post "/api/runner/claim?$query" /dev/null $((WAIT + 15)) "$WORK/kinds"

  case "$CODE" in
    200)
      backoff=1
      quiet=0
      run_job
      ;;
    204)
      backoff=1
      quiet=0
      # Between jobs: keep current, if the config asks (#1658).
      latest=$(header x-runner-latest)
      case "${SELF_UPDATE:-}" in
        1 | yes | true | on)
          case "$latest" in
            '' | *[!0-9a-f]* | "$MY_SHA" | "$SKIP_SHA") ;;
            *)
              if self_update "$latest"; then
                [ -n "$ONCE" ] && exit 0
                rm -rf "$WORK"
                exec sh "$SELF" "$@"
              fi
              SKIP_SHA=$latest
              ;;
          esac
          ;;
      esac
      # A server stopping for a deploy says how long to wait before asking
      # again, by when its replacement is there to answer.
      pause=$(header retry-after)
      case "$pause" in '' | *[!0-9]*) pause=0 ;; esac
      [ "$pause" -gt 60 ] && pause=60
      [ -z "$ONCE" ] && [ "$pause" -gt 0 ] && sleep "$pause"
      ;;
    401 | 403)
      say "the server refused this runner (HTTP $CODE): $(cat "$WORK/resp" 2>/dev/null)"
      exit 1
      ;;
    *)
      # A claim the proxy lost when the app went down for a deploy (502, or
      # the connection dropped without a proxy) is retried at once, and
      # quietly: only a few in a row are worth a line in the log.
      case "$CODE" in 000 | 502 | 503 | 504) gateway=1 ;; *) gateway= ;; esac
      if [ -z "$ONCE" ] && [ -n "$gateway" ] && [ "$quiet" -lt 3 ]; then
        quiet=$((quiet + 1))
        sleep 1
      else
        say "could not reach the queue (HTTP $CODE) — trying again in ${backoff}s"
        [ -n "$ONCE" ] && exit 1
        sleep "$backoff"
        backoff=$((backoff * 2))
        [ "$backoff" -gt 60 ] && backoff=60
      fi
      ;;
  esac

  [ -n "$ONCE" ] && exit 0
done
