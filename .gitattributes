# Shell scripts must keep LF endings whatever the checkout platform does.
# Git for Windows converts to CRLF by default, and a setup.sh with carriage
# returns in it fails on the second line with "set: Illegal option" — which
# tells the reader nothing about what is actually wrong.
*.sh text eol=lf
docker-entrypoint.sh text eol=lf

# Same reasoning: these are read by Linux containers and tools, not by Notepad.
Dockerfile text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
.env.example text eol=lf
