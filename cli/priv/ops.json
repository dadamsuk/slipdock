[
  {
    "name": "move_card",
    "summary": "Moves a card to a list on its board: to the doing list when you start it. With board, to another board, subcards and all. To finish a card use complete_card, which also marks it done.",
    "verb": "POST",
    "path": "/api/cards/:id/move",
    "writes": true,
    "params": [
      {
        "name": "card",
        "type": "integer",
        "required": true,
        "in_path": "id"
      },
      {
        "name": "column",
        "type": "string",
        "required": false
      },
      {
        "name": "index",
        "type": "position",
        "required": false,
        "default": "bottom"
      },
      {
        "name": "board",
        "type": "string",
        "required": false
      }
    ],
    "cli": {
      "command": "move",
      "positional": [
        "card",
        "column..."
      ],
      "flags": {
        "board": {
          "param": "board"
        },
        "bottom": {
          "param": "index",
          "value": "bottom"
        },
        "index": {
          "param": "index"
        },
        "top": {
          "param": "index",
          "value": "top"
        }
      }
    }
  },
  {
    "name": "archive_card",
    "summary": "Archives a card: off the board and out of listings, kept and restorable. restore = true brings it back. Finished work goes to done, not here.",
    "verb": "POST",
    "path": "/api/cards/:id/archive",
    "writes": true,
    "params": [
      {
        "name": "card",
        "type": "integer",
        "required": true,
        "in_path": "id"
      },
      {
        "name": "restore",
        "type": "boolean",
        "required": false,
        "default": false
      }
    ],
    "cli": {
      "command": "archive",
      "positional": [
        "card"
      ],
      "flags": {
        "restore": {
          "param": "restore",
          "value": true
        }
      }
    }
  },
  {
    "name": "delete_card",
    "summary": "Deletes a card and its subcards, comments and files. Cannot be undone; archive_card is the safe way. Needs confirm = true.",
    "verb": "DELETE",
    "path": "/api/cards/:id",
    "writes": true,
    "params": [
      {
        "name": "card",
        "type": "integer",
        "required": true,
        "in_path": "id"
      }
    ],
    "cli": {
      "command": "delete",
      "positional": [
        "card"
      ],
      "flags": {}
    }
  },
  {
    "name": "leave_handoff",
    "summary": "Leaves the card's handoff for whoever picks it up next: write one whenever you stop unfinished. It replaces the last (kept as history); get_card shows it first. next_step: one line; body: the note. clear: true clears it; delete: true deletes it.",
    "verb": "POST",
    "path": "/api/cards/:id/handoff",
    "writes": true,
    "params": [
      {
        "name": "card",
        "type": "integer",
        "required": true,
        "in_path": "id"
      },
      {
        "name": "next_step",
        "type": "string",
        "required": false
      },
      {
        "name": "body",
        "type": "string",
        "required": false
      },
      {
        "name": "clear",
        "type": "boolean",
        "required": false,
        "default": false
      },
      {
        "name": "delete",
        "type": "boolean",
        "required": false,
        "default": false
      }
    ],
    "cli": {
      "command": "handoff",
      "positional": [
        "card"
      ],
      "flags": {
        "body": {
          "param": "body"
        },
        "clear": {
          "param": "clear",
          "value": true
        },
        "delete": {
          "param": "delete",
          "value": true
        },
        "next": {
          "param": "next_step"
        }
      }
    }
  }
]
