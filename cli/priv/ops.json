        },
        "name": {
          "param": "name"
        },
        "version": {
          "param": "version"
        }
      }
    }
  },
  {
    "name": "activity",
    "summary": "A board's activity log, newest first; card = only that card's. view=ledger: what shipped since (days, a date or a time; 07:00 yesterday by default), with who accepted it and its evidence.",
    "verb": "GET",
    "path": "/api/boards/:board/activity",
    "writes": false,
    "params": [
      {
        "name": "board",
        "type": "string",
        "required": true,
        "in_path": "board"
      },
      {
        "name": "card",
        "type": "integer",
        "required": false
      },
      {
        "name": "limit",
        "type": "integer",
        "required": false,
        "default": 30
      },
      {
        "name": "view",
        "type": {
          "enum": [
            "log",
            "ledger"
          ]
        },
        "required": false,
        "default": "log"
      },
      {
        "name": "since",
        "type": "string",
        "required": false
      }
    ],
    "cli": {
      "command": "activity",
      "positional": [
        "board"
      ],
      "flags": {
        "card": {
          "param": "card"
        },
        "limit": {
          "param": "limit"
        },
        "since": {
          "param": "since"
        },
        "view": {
          "param": "view"
        }
      }
    }
  },
  {
    "name": "garden_decide",
    "summary": "Applies or dismisses one garden suggestion the person approved; never a list on your own judgment. A dismissal sticks unless its subject changes; undo puts an applied one back. keep and choice: see their fields. Needs confirm.",
    "verb": "POST",
    "path": "/api/garden/suggestions/:id/:decision",
    "writes": true,
    "params": [
      {
        "name": "suggestion",
        "type": "integer",
        "required": true,
        "in_path": "id"
      },
      {
        "name": "decision",
        "type": {
          "enum": [
            "apply",
            "dismiss",
            "undo"
          ]
        },
        "required": true,
        "in_path": "decision"
      },
      {
        "name": "keep",
        "type": "integer",
        "required": false
      },
      {
        "name": "choice",
        "type": "string",
        "required": false
      }
    ],
    "cli": {
      "command": "garden",
      "positional": [
        "decision",
        "suggestion"
      ],
      "flags": {
        "choice": {
          "param": "choice"
        },
        "keep": {
          "param": "keep"
        }
      }
    }
  },
  {
    "name": "revert_page",
    "summary": "Puts a page back to a revision from page_history, as a new revision (nothing is lost). Needs base_hash: the page's current content_hash, from read_page or page_history.",
    "verb": "POST",
    "path": "/api/pages/:id/revert",
    "writes": true,
    "params": [
      {
        "name": "page",
        "type": "string",
        "required": true,
        "in_path": "id"
      },
      {
        "name": "board",
        "type": "string",
        "required": false
      },
      {
        "name": "revision",
        "type": "integer",
        "required": true
      },
      {
        "name": "base_hash",
        "type": "string",
        "required": true
      },
      {
        "name": "message",
        "type": "string",
        "required": false
      }
    ],
    "cli": {
      "command": "page revert",
      "positional": [
        "page"
      ],
      "flags": {
        "base_hash": {
          "param": "base_hash"
        },
        "message": {
          "param": "message"
        },
        "rev": {
          "param": "revision"
        }
      }
    }
  },
  {
    "name": "page_history",
    "summary": "A page's revisions, newest first: id, author, via, summary, time. With rev, that revision's body; diff: \"previous\" (or another revision's id) adds the change it made, and without rev is the latest save's. revert_page puts a revision back.",
    "verb": "GET",
    "path": "/api/pages/:id/revisions",
    "writes": false,
    "params": [
      {
        "name": "page",
        "type": "string",
        "required": true,
        "in_path": "id"
      },
      {
        "name": "board",
        "type": "string",
        "required": false
      },
      {
        "name": "limit",
        "type": "integer",
        "required": false,
        "default": 100
      },
      {
        "name": "rev",
        "type": "integer",
        "required": false
      },
      {
        "name": "diff",
        "type": "any",
        "required": false
      }
    ],
    "cli": {
      "command": "page history",
      "positional": [
        "page"
      ],
      "flags": {
        "against": {
          "param": "diff"
        },
        "limit": {
          "param": "limit"
        },
        "rev": {
          "param": "rev"
        }
      }
    }
  },
