[
  {
    "name": "move_card",
    "summary": "Moves a card to a list on its board: to the doing list when you start it. With board, to another board, subcards and all. To finish a card use complete_card, which also marks it done.",
    "verb": "POST",
    "path": "/api/cards/:id/move",
    "writes": true,
    "params": [
      {
        "name": "card",
        "type": "integer",
        "required": true,
        "in_path": "id"
      },
      {
        "name": "column",
        "type": "string",
        "required": false
      },
      {
        "name": "index",
        "type": "position",
        "required": false,
        "default": "bottom"
      },
      {
        "name": "board",
        "type": "string",
        "required": false
      }
    ],
    "cli": {
      "command": "move",
      "positional": [
        "card",
        "column..."
      ],
      "flags": {
        "board": {
          "param": "board"
        },
        "bottom": {
          "param": "index",
          "value": "bottom"
        },
        "index": {
          "param": "index"
        },
        "top": {
          "param": "index",
          "value": "top"
        }
      }
    }
  },
  {
    "name": "archive_card",
    "summary": "Archives a card: off the board and out of listings, kept and restorable. restore = true brings it back. Finished work goes to done, not here.",
    "verb": "POST",
    "path": "/api/cards/:id/archive",
    "writes": true,
    "params": [
      {
        "name": "card",
        "type": "integer",
        "required": true,
        "in_path": "id"
      },
      {
        "name": "restore",
        "type": "boolean",
        "required": false,
        "default": false
      }
    ],
    "cli": {
      "command": "archive",
      "positional": [
        "card"
      ],
      "flags": {
        "restore": {
          "param": "restore",
          "value": true
        }
      }
    }
  },
  {
    "name": "delete_card",
    "summary": "Deletes a card and its subcards, comments and files. Cannot be undone; archive_card is the safe way. Needs confirm = true.",
    "verb": "DELETE",
    "path": "/api/cards/:id",
    "writes": true,
    "params": [
      {
        "name": "card",
        "type": "integer",
        "required": true,
        "in_path": "id"
      }
    ],
    "cli": {
      "command": "delete",
      "positional": [
        "card"
      ],
      "flags": {}
    }
  },
  {
    "name": "leave_handoff",
    "summary": "Leaves the card's handoff for whoever picks it up next: write one whenever you stop unfinished. It replaces the last (kept as history); get_card shows it first. next_step: one line; body: the note. clear: true clears it; delete: true deletes it.",
    "verb": "POST",
    "path": "/api/cards/:id/handoff",
    "writes": true,
    "params": [
      {
        "name": "card",
        "type": "integer",
        "required": true,
        "in_path": "id"
      },
      {
        "name": "next_step",
        "type": "string",
        "required": false
      },
      {
        "name": "body",
        "type": "string",
        "required": false
      },
      {
        "name": "clear",
        "type": "boolean",
        "required": false,
        "default": false
      },
      {
        "name": "delete",
        "type": "boolean",
        "required": false,
        "default": false
      }
    ],
    "cli": {
      "command": "handoff",
      "positional": [
        "card"
      ],
      "flags": {
        "body": {
          "param": "body"
        },
        "clear": {
          "param": "clear",
          "value": true
        },
        "delete": {
          "param": "delete",
          "value": true
        },
        "next": {
          "param": "next_step"
        }
      }
    }
  },
  {
    "name": "verify_card",
    "summary": "Accepts or rejects a card waiting for verification, after checking it at the evidence's commit. accept completes it; reject needs the reason and a failing check. checks: the verdict in parts. Not on a card you submitted.",
    "verb": "POST",
    "path": "/api/cards/:id/verify",
    "writes": true,
    "params": [
      {
        "name": "card",
        "type": "integer",
        "required": true,
        "in_path": "id"
      },
      {
        "name": "decision",
        "type": {
          "enum": [
            "accept",
            "reject",
            "merged",
            "agree",
            "disagree"
          ]
        },
        "required": true
      },
      {
        "name": "reason",
        "type": "string",
        "required": false
      },
      {
        "name": "commit",
        "type": "string",
        "required": false
      },
      {
        "name": "checks",
        "type": "any",
        "required": false
      }
    ],
    "cli": {
      "command": "verify",
      "positional": [
        "card",
        "decision"
      ],
      "flags": {
        "check": {
          "param": "checks"
        },
        "evidence_commit": {
          "param": "commit"
        },
        "reason": {
          "param": "reason"
        }
      }
    }
  },
  {
    "name": "create_tag",
    "summary": "Adds a tag to a board (shared by its sub-boards), so create_card and update_card can put it on cards. A tag of that name already there is returned, not doubled. Making a new one needs edit access to the tree's root board.",
    "verb": "POST",
    "path": "/api/boards/:board/tags",
    "writes": true,
    "params": [
      {
        "name": "board",
        "type": "string",
        "required": true,
        "in_path": "board"
      },
      {
        "name": "name",
        "type": "string",
        "required": true
      },
      {
        "name": "color",
        "type": {
          "enum": [
            "slate",
            "red",
            "orange",
            "amber",
            "lime",
            "emerald",
            "teal",
            "sky",
            "indigo",
            "violet",
            "fuchsia",
            "rose"
          ]
        },
        "required": false
      }
    ],
    "cli": {
      "command": "new-tag",
      "positional": [
        "board",
        "name..."
      ],
      "flags": {
        "color": {
          "param": "color"
        }
      }
    }
  },
  {
    "name": "delete_board",
    "summary": "Deletes a board you own with all its cards, pages and files. Cannot be undone; archive_board is the safe way. confirm must repeat the board's code.",
    "verb": "DELETE",
    "path": "/api/boards/:board",
    "writes": true,
    "params": [
      {
        "name": "board",
        "type": "string",
        "required": true,
        "in_path": "board"
      }
    ]
  },
  {
    "name": "quick_note",
    "summary": "Saves text as a note in the person's wiki. The server names it (date, time, a title from the content) and picks the folder, and says where it went. Use write_page to choose the board and title.",
    "verb": "POST",
    "path": "/api/notes",
    "writes": true,
    "params": [
      {
        "name": "text",
        "type": "string",
        "required": true
      }
    ],
    "cli": {
      "command": "note",
      "positional": [
        "text..."
      ],
      "flags": {}
    }
  },
  {
    "name": "page_tool",
    "summary": "Runs a model over a wiki page on your AI key and returns the answer; writes nothing. tool: summarise, key_points, actions, titles or improve.",
    "verb": "POST",
    "path": "/api/pages/:id/ai",
    "writes": false,
    "params": [
      {
        "name": "page",
        "type": "string",
        "required": true,
        "in_path": "id"
      },
      {
        "name": "board",
        "type": "string",
        "required": false
      },
      {
        "name": "tool",
        "type": {
          "enum": [
            "summarise",
            "key_points",
            "actions",
            "titles",
            "improve"
          ]
        },
        "required": true
      }
    ],
    "cli": {
      "command": "page ai",
      "positional": [
        "page",
        "tool"
      ],
      "flags": {
        "board": {
          "param": "board"
        }
      }
    }
  },
  {
    "name": "keep_job_log",
    "summary": "Keeps an ended runner job's live log, which otherwise expires: writes it as a page Pass <card> (<date>) in the card's folder and links it from the job. Again gives the same page.",
    "verb": "POST",
    "path": "/api/jobs/:id/keep",
    "writes": true,
    "params": [
      {
        "name": "job",
        "type": "integer",
        "required": true,
        "in_path": "id"
      }
    ],
    "cli": {
      "command": "job --keep",
      "positional": [
        "job"
      ],
      "flags": {}
    }
  },
  {
    "name": "install_tool",
    "summary": "Builds the board a Tool (see list_tools) comes with and returns its code. Already installed, it adds what a newer version brings without touching edited pages. tool: \"handbook\" or tool: \"sweep\" with board installs that on its root instead.",
    "verb": "POST",
    "path": "/api/tools/:slug/install",
    "writes": true,
    "params": [
      {
        "name": "tool",
        "type": "string",
        "required": true,
        "in_path": "slug"
      },
      {
        "name": "version",
        "type": "string",
        "required": false
      },
      {
        "name": "name",
        "type": "string",
        "required": false
      },
      {
        "name": "board",
        "type": "string",
        "required": false
      }
    ],
    "cli": {
      "command": "tools install-board",
      "positional": [
        "tool"
      ],
      "flags": {
        "board": {
          "param": "board"
        },
        "name": {
          "param": "name"
        },
        "version": {
          "param": "version"
        }
      }
    }
  },
  {
    "name": "activity",
    "summary": "A board's activity log, newest first; card = only that card's. view=ledger: what shipped since (days, a date or a time; 07:00 yesterday by default), with who accepted it and its evidence.",
    "verb": "GET",
    "path": "/api/boards/:board/activity",
    "writes": false,
    "params": [
      {
        "name": "board",
        "type": "string",
        "required": true,
        "in_path": "board"
      },
      {
        "name": "card",
        "type": "integer",
        "required": false
      },
      {
        "name": "limit",
        "type": "integer",
        "required": false,
        "default": 30
      },
      {
        "name": "view",
        "type": {
          "enum": [
            "log",
            "ledger"
          ]
        },
        "required": false,
        "default": "log"
      },
      {
        "name": "since",
        "type": "string",
        "required": false
      }
    ],
    "cli": {
      "command": "activity",
      "positional": [
        "board"
      ],
      "flags": {
        "card": {
          "param": "card"
        },
        "limit": {
          "param": "limit"
        },
        "since": {
          "param": "since"
        },
        "view": {
          "param": "view"
        }
      }
    }
  },
  {
    "name": "garden_decide",
    "summary": "Applies or dismisses one garden suggestion the person approved; never a list on your own judgment. A dismissal sticks unless its subject changes; undo puts an applied one back. keep and choice: see their fields. Needs confirm.",
    "verb": "POST",
    "path": "/api/garden/suggestions/:id/:decision",
    "writes": true,
    "params": [
      {
        "name": "suggestion",
        "type": "integer",
        "required": true,
        "in_path": "id"
      },
      {
        "name": "decision",
        "type": {
          "enum": [
            "apply",
            "dismiss",
            "undo"
          ]
        },
        "required": true,
        "in_path": "decision"
      },
      {
        "name": "keep",
        "type": "integer",
        "required": false
      },
      {
        "name": "choice",
        "type": "string",
        "required": false
      }
    ],
    "cli": {
      "command": "garden",
      "positional": [
        "decision",
        "suggestion"
      ],
      "flags": {
        "choice": {
          "param": "choice"
        },
        "keep": {
          "param": "keep"
        }
      }
    }
  },
  {
    "name": "revert_page",
    "summary": "Puts a page back to a revision from page_history, as a new revision (nothing is lost). Needs base_hash: the page's current content_hash, from read_page or page_history.",
    "verb": "POST",
    "path": "/api/pages/:id/revert",
    "writes": true,
    "params": [
      {
        "name": "page",
        "type": "string",
        "required": true,
        "in_path": "id"
      },
      {
        "name": "board",
        "type": "string",
        "required": false
      },
      {
        "name": "revision",
        "type": "integer",
        "required": true
      },
      {
        "name": "base_hash",
        "type": "string",
        "required": true
      },
      {
        "name": "message",
        "type": "string",
        "required": false
      }
    ],
    "cli": {
      "command": "page revert",
      "positional": [
        "page"
      ],
      "flags": {
        "base_hash": {
          "param": "base_hash"
        },
        "message": {
          "param": "message"
        },
        "rev": {
          "param": "revision"
        }
      }
    }
  }
]
