# Every setting this app reads from the environment, with its default.
#
# Copy to `.env` beside the app (or at the path in SLIPDOCK_ENV_FILE) and keep
# only the lines you actually want to change — each one shown here is the
# default, so an empty file is a working configuration.
#
# `config/runtime.exs` reads this file itself, so `mix phx.server` and the
# systemd unit (deploy/kanban.service) behave the same. Variables already set
# in the real environment win over this file. It holds secrets: keep it out of
# git (it already is) and chmod 600.
#
# Nothing here is specific to whoever wrote the app. If you find something that
# is, that is a bug worth reporting.

# ── The server ──────────────────────────────────────────────────────────────

# Port to listen on.
# PORT=4000

# What to bind in development. Unset, the dev server prefers this machine's
# Tailscale IPv4 (so the app is reachable on your tailnet and nowhere else) and
# falls back to loopback when there is no Tailscale. Set it explicitly for
# anything else: 0.0.0.0 for every interface, 127.0.0.1 for this machine only.
# SLIPDOCK_BIND_IP=127.0.0.1

# The hostname to put in links the app generates (sign-in emails especially).
# Defaults to the Tailscale IP, else localhost.
# SLIPDOCK_URL_HOST=kanban.example.com

# Where people actually reach the app, if that differs from the address the
# endpoint is configured with — behind a reverse proxy, say. Used by automation
# emails so their links work.
# SLIPDOCK_BASE_URL=https://kanban.example.com

# How the app describes itself in the links it generates (sign-in emails
# especially). Defaults to https on 443, which is right for a server on the
# internet; the Docker container speaks plain http and sets these for you.
# SLIPDOCK_URL_SCHEME=https
# SLIPDOCK_URL_PORT=443

# Other names this server answers to. Live updates (the WebSocket) are refused
# when the browser's Origin is not the host above, so add any others you use —
# or "false" to accept any origin, which gives up a protection and is a last
# resort.
# SLIPDOCK_CHECK_ORIGIN=kanban.example.com,//kanban.local:4000

# How the port is published on the host, for docker compose only.
# SLIPDOCK_PUBLISH=4000

# Production only (MIX_ENV=prod): both are required and the app refuses to boot
# without them. Generate the secret with `mix phx.gen.secret`.
# SECRET_KEY_BASE=
# PHX_HOST=kanban.example.com
# Where the SQLite file lives. Required in prod; in dev it defaults to
# slipdock_dev.db in the project directory, and setting it is how you run
# against a throwaway database (the demo workspace, say).
# DATABASE_PATH=/var/lib/slipdock/kanban.db
# POOL_SIZE=5
# PHX_SERVER=true

# ── Who may sign in ─────────────────────────────────────────────────────────

# By default the first address to sign in claims an empty instance, and after
# that only people who already have an account can get in.
#
# A comma-separated list of addresses and of domains that may also sign up. A
# bare domain lets anybody there in, which is how you admit a team.
# SLIPDOCK_SIGNUP_ALLOW=you@example.com,example.org

# Or let anyone at all sign up — only sensible when the server is already behind
# a boundary of your own (a tailnet, a VPN, an authenticating proxy).
# SLIPDOCK_OPEN_SIGNUP=false

# Writes a working sign-in link for ANY address to a file instead of emailing
# it, so an automated test can sign itself in. That is an authentication bypass:
# leave it off on anything other people can reach. A server with it on says so
# in the log on every boot.
# SLIPDOCK_AGENTIC_LOGIN=false
# SLIPDOCK_AGENTIC_LOGIN_DIR=/tmp

# ── Mail (sign-in links, automation emails) ─────────────────────────────────

# Without a host, no mail leaves the machine: it stays in the in-memory mailbox
# at /dev/mailbox and the sign-in link is written to the log instead. That is
# fine for a single user who can read the log.
# SLIPDOCK_SMTP_HOST=smtp.example.com
# SLIPDOCK_SMTP_PORT=587

# Omit both for an IP-authorised relay that needs no credentials.
# SLIPDOCK_SMTP_USER=
# SLIPDOCK_SMTP_PASSWORD=

# The From: address on everything the app sends. Must be one your relay will
# accept.
# SLIPDOCK_MAIL_FROM=kanban@localhost

# ── AI (optional; everything else works without it) ─────────────────────────

# Keys are per-person: each account sets one under Account → AI key and they
# are stored here, 0600, outside the database. Back it up like a secret.
# SLIPDOCK_AI_KEY_FILE=ai_keys.json

# A key here would be shared by *everyone* on the server, which is rarely what
# you want. Leave it unset unless you mean it.
# OPENROUTER_API_KEY=

# Unattended work — the search indexer, scheduled automations — has no person to
# bill. It uses this account's key; on a one-person instance the only stored key
# is used without being named.
# SLIPDOCK_AI_SYSTEM_USER=you@example.com

# Which models. The defaults are chosen for price.
# SLIPDOCK_AI_MODEL=google/gemini-2.5-flash-lite
# SLIPDOCK_AI_QUICK_MODEL=
# SLIPDOCK_AI_EMBED_MODEL=openai/text-embedding-3-small
# SLIPDOCK_AI_EMBED_DIMENSIONS=768

# ── Files and source ────────────────────────────────────────────────────────

# Where uploaded files are kept. Defaults to priv/uploads inside the app, which
# a release will replace on upgrade — point it somewhere of your own in
# production.
# SLIPDOCK_UPLOADS_DIR=/var/lib/slipdock/uploads

# This app is AGPL-3.0, so the people using it over a network are entitled to
# the source of the version you are running. The Account page links to this —
# point it at your own repository if you run a modified copy.
# SLIPDOCK_SOURCE_URL=https://github.com/dadamsuk/slipdock

# Read this file from somewhere else entirely.
# SLIPDOCK_ENV_FILE=/etc/kanban/env
