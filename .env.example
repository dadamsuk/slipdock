# Every setting this app reads from the environment, with its default.
#
# Copy to `.env` beside the app (or at the path in SLIPDOCK_ENV_FILE) and keep
# only the lines you actually want to change — each one shown here is the
# default, so an empty file is a working configuration.
#
# `config/runtime.exs` reads this file itself, so `mix phx.server` and the
# systemd unit (deploy/kanban.service) behave the same. Variables already set
# in the real environment win over this file. It holds secrets: keep it out of
# git (it already is) and chmod 600.
#
# Nothing here is specific to whoever wrote the app. If you find something that
# is, that is a bug worth reporting.

# ── The server ──────────────────────────────────────────────────────────────

# Port to listen on.
# PORT=4000

# What to bind in development. Unset, the dev server prefers this machine's
# Tailscale IPv4 (so the app is reachable on your tailnet and nowhere else) and
# falls back to loopback when there is no Tailscale. Set it explicitly for
# anything else: 0.0.0.0 for every interface, 127.0.0.1 for this machine only.
# SLIPDOCK_BIND_IP=127.0.0.1

# The dev server's mailbox (/dev/mailbox, every sign-in link it has "sent") and
# debug error pages. Turn them off if anybody else can reach a dev server —
# better, run the release (deploy/slipdock.service). Read at compile time.
# SLIPDOCK_DEV_TOOLS=false

# The hostname to put in links the app generates (sign-in emails especially).
# Defaults to the Tailscale IP, else localhost.
# SLIPDOCK_URL_HOST=kanban.example.com

# Where people actually reach the app, if that differs from the address the
# endpoint is configured with — behind a reverse proxy, say. Used by automation
# emails so their links work.
# SLIPDOCK_BASE_URL=https://kanban.example.com

# How the app describes itself in the links it generates (sign-in emails
# especially). Defaults to https on 443, which is right for a server on the
# internet; the Docker container speaks plain http and sets these for you.
# SLIPDOCK_URL_SCHEME=https
# SLIPDOCK_URL_PORT=443

# Other names this server answers to. Live updates (the WebSocket) are refused
# when the browser's Origin is not the host above, so add any others you use —
# or "false" to accept any origin, which gives up a protection and is a last
# resort.
# SLIPDOCK_CHECK_ORIGIN=kanban.example.com,//kanban.local:4000

# How the port is published on the host, for docker compose only.
# SLIPDOCK_PUBLISH=4000

# Production only (MIX_ENV=prod): both are required and the app refuses to boot
# without them. Generate the secret with `mix phx.gen.secret`.
# SECRET_KEY_BASE=

# The address people reach this server by — a hostname, not an IP, if you have
# one. Sign-in links are built from it, and live updates are refused for any
# other name, so a page opened elsewhere loads and then never changes.
#
# Setting it here is the durable way; `export PHX_HOST=...` in your shell works
# too, but only for that shell — and it must be `export`, since a plain
# `PHX_HOST=...` is not passed to containers even though `echo $PHX_HOST` will
# cheerfully print it.
#
# After changing either, `docker compose up -d`. NOT `restart`: that reuses the
# container and re-reads nothing.
# PHX_HOST=slipdock.example.com

# The database. Under compose you do not need to set this at all: the app
# builds the URL from the POSTGRES_* values below, which the bundled postgres
# service uses too, so setting the password here changes both ends at once.
#
# Set DATABASE_URL instead to point at a Postgres you run yourself, in which
# case the POSTGRES_* values are ignored (remove the `postgres` service from
# compose.yaml as well). In development it defaults to the server in
# compose.dev.yaml on 127.0.0.1:5434.
#
# POSTGRES_USER=slipdock
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=slipdock
# DATABASE_URL=postgres://slipdock:change-me@postgres:5432/slipdock
#
# A managed Postgres almost certainly wants TLS; one on compose's own network
# does not. DATABASE_SSL_VERIFY=false skips checking the certificate chain,
# which is what a provider using its own CA needs.
# DATABASE_SSL=true
# DATABASE_SSL_VERIFY=false
# ECTO_IPV6=true
# POOL_SIZE=10
# PHX_SERVER=true

# ── Who may sign in ─────────────────────────────────────────────────────────

# EVERYTHING IN THIS SECTION AND THE NEXT IS A SEED, NOT A SETTING. These are
# written into the database the first time the server starts and ignored from
# then on, because the same things are editable in the app. Changing one later
# does nothing — change it in the app instead.
#
# The exceptions, which are overrides and win every time, say so where they are.

# Naming an admin here skips the setup wizard entirely, which is what you want
# in a container: that address becomes the admin and /setup never appears.
# SLIPDOCK_ADMIN_EMAIL=you@example.com

# Who may register:
#   closed     accounts exist only because you made them (the default)
#   allowlist  the addresses and domains in SLIPDOCK_SIGNUP_ALLOW
#   approval   people ask and an admin says yes — needs working mail
#   open       anybody at all, only sensible when the server is already behind
#              a boundary of your own (a tailnet, a VPN, an authenticating proxy)
# SLIPDOCK_SIGNUP_MODE=closed

# A comma-separated list of addresses and of domains that may sign up under the
# allowlist mode. A bare domain lets anybody there in, which is how you admit a
# team.
# SLIPDOCK_SIGNUP_ALLOW=you@example.com,example.org

# The older way of saying SLIPDOCK_SIGNUP_MODE=open. Still read, for upgrades.
# SLIPDOCK_OPEN_SIGNUP=false

# How many cards one person's own boards may hold before they need to pay for
# more. Empty means no limit, which is what a self-hosted install wants.
# SLIPDOCK_FREE_CARD_LIMIT=

# Who shows up in assignee pickers, mentions and the prompts sent to a model:
#   instance     everyone on this server (right for a team or one person)
#   shared_only  only people you actually share a board, card or page with
#                (right when strangers share the server)
# SLIPDOCK_USER_DIRECTORY=instance

# Whether sharing a board or card with an address that has no account here
# creates one, subject to the card limit above. Off means you can only share
# with people who already have accounts.
# SLIPDOCK_INVITES_CREATE_ACCOUNTS=true

# AN OVERRIDE, NOT A SEED. Sign-in codes are written to a file when no mail is
# configured, so a fresh install has a way in at all — and anyone who can read
# that file can sign in as anybody. Set this to false on a host other people
# can reach, and the app cannot turn it back on.
# SLIPDOCK_LOGIN_FALLBACK=true

# Where that file goes. The default is under the app's working directory, which
# inside a container is neither obvious nor persistent — put it on the volume.
# SLIPDOCK_LOGIN_FALLBACK_PATH=/data/sign-in-links.log

# Writes a working sign-in link for ANY address to a file instead of emailing
# it, so an automated test can sign itself in. That is an authentication bypass:
# leave it off on anything other people can reach. A server with it on says so
# in the log on every boot.
# SLIPDOCK_AGENTIC_LOGIN=false
# Where the files go (each mode 0600). Unset, a private slipdock-agentic-login
# directory under the system temp dir.
# SLIPDOCK_AGENTIC_LOGIN_DIR=/var/lib/slipdock/agentic-login

# ── Mail (sign-in links, automation emails) ─────────────────────────────────

# Seeds, like the section above: these are carried into the settings on first
# boot and are editable in the app afterwards, where there is also a test-send
# button. Changing them here later does nothing.

# Without a host, no mail leaves the machine: it stays in the in-memory mailbox
# at /dev/mailbox and the sign-in link is written to the log instead. That is
# fine for a single user who can read the log.
# SLIPDOCK_SMTP_HOST=smtp.example.com
# SLIPDOCK_SMTP_PORT=587

# Omit both for an IP-authorised relay that needs no credentials.
# SLIPDOCK_SMTP_USER=
# SLIPDOCK_SMTP_PASSWORD=

# The relay's TLS certificate is checked against the system's CA store and the
# host name above. A relay with a self-signed certificate needs this.
# SLIPDOCK_SMTP_TLS_VERIFY=false

# The From: address on everything the app sends. Must be one your relay will
# accept.
# SLIPDOCK_MAIL_FROM=kanban@localhost

# ── AI (optional; everything else works without it) ─────────────────────────

# Per-person AI settings — key, endpoint, model — live in one JSON file, 0600,
# outside the database. Each account sets its own under Account → AI model.
# Back it up like a secret.
# SLIPDOCK_AI_KEY_FILE=ai_keys.json

# A key here would be shared by *everyone* on the server, which is rarely what
# you want. Leave it unset unless you mean it.
# OPENROUTER_API_KEY=

# AN OVERRIDE, AND THE LEVER FOR RUNNING THIS FOR OTHER PEOPLE. The shared key
# above is spent by everybody on the server, so on a hosted instance the
# operator pays for everyone's AI. Set this and only admins fall back to it;
# everybody else brings their own key (Account → AI key) or gets no AI.
# Off by default — the card limit already bounds how much one account can index.
# SLIPDOCK_SHARED_AI_KEY_ADMINS_ONLY=false

# Unattended work — the search indexer, scheduled automations — has no person to
# bill. It uses this account's key and endpoint; with registration closed and an
# admin the only one with settings stored, theirs are used without being named.
# Nobody else's ever is: the indexer sends every board through them.
# SLIPDOCK_AI_SYSTEM_USER=you@example.com

# The endpoint everyone falls back to. Any OpenAI-compatible chat completions
# API works, so pointing this at a model server on the LAN makes the whole
# instance local — and needs no key at all. Individuals can override it for
# themselves under Account → AI model.
# SLIPDOCK_AI_BASE_URL=https://openrouter.ai/api/v1
# SLIPDOCK_AI_BASE_URL=http://llm.local:1234/v1     # LM Studio
# SLIPDOCK_AI_BASE_URL=http://llm.local:11434/v1    # Ollama

# Webhooks and the endpoints people pick for themselves may only reach public
# addresses: loopback, private, link-local and CGNAT/Tailscale ones are refused
# (admins' own endpoints and the default above excepted). Reopen ranges with a
# comma-separated list of CIDRs, or "all" to switch the check off.
# SLIPDOCK_EGRESS_ALLOW=fd00::/8
# SLIPDOCK_EGRESS_ALLOW=all

# Proxies whose X-Forwarded-For is believed, as CIDRs. Unset: loopback and the
# private ranges. Anything else could pick its own address and dodge the
# sign-in limits, so list only what really sits in front of this server.
# SLIPDOCK_TRUSTED_PROXIES=127.0.0.1/32,172.16.0.0/12
# SLIPDOCK_TRUSTED_PROXIES=none

# Which models. The defaults are chosen for price, and name OpenRouter models —
# a local endpoint wants its own ids (ask it for /v1/models, or use the Account
# page's model picker).
# SLIPDOCK_AI_MODEL=google/gemini-2.5-flash-lite
# SLIPDOCK_AI_QUICK_MODEL=
# SLIPDOCK_AI_EMBED_MODEL=openai/text-embedding-3-small
# SLIPDOCK_AI_EMBED_DIMENSIONS=768

# ── Files and source ────────────────────────────────────────────────────────

# Where uploaded files are kept. Defaults to priv/uploads inside the app, which
# a release will replace on upgrade — point it somewhere of your own in
# production.
# SLIPDOCK_UPLOADS_DIR=/var/lib/slipdock/uploads

# This app is AGPL-3.0, so the people using it over a network are entitled to
# the source of the version you are running. The Account page links to this —
# point it at your own repository if you run a modified copy.
# SLIPDOCK_SOURCE_URL=https://github.com/dadamsuk/slipdock

# Configuration says when a newer image has been published, by asking the
# registry while an admin has the page open. Off for a server that must not
# reach the internet; pointed at your own image if you publish a fork.
# SLIPDOCK_UPDATE_CHECK=false
# SLIPDOCK_UPDATE_IMAGE=ghcr.io/dadamsuk/slipdock

# Read this file from somewhere else entirely.
# SLIPDOCK_ENV_FILE=/etc/kanban/env
