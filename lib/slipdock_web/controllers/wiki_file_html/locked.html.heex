<Layouts.app flash={@flash} current_user={@current_user}>
  <div class="mx-auto max-w-3xl px-4 py-8">
    <div class="flex items-center gap-2">
      <.icon name="hero-lock-closed" class="size-5 text-base-content/50" />
      <h1 class="text-xl font-semibold tracking-tight">{@file.name}</h1>
    </div>
    <p class="mt-1 text-sm text-base-content/60">
      A whole note encrypted with Meld Encrypt. It is decrypted here in your browser;
      the passphrase and the text never reach the server.
    </p>

    <div :if={@note} class="mt-6">
      <span
        id="meld-note"
        class="meld-locked meld-note"
        role="button"
        tabindex="0"
        title="Encrypted. Select to decrypt in this browser"
        data-meld-note={@json}
      >
        🔒 Encrypted <span :if={@note.hint != ""} class="meld-hint">{@note.hint}</span>
      </span>
    </div>

    <p :if={is_nil(@note)} class="mt-6 rounded-xl bg-warning/10 p-4 text-sm">
      This file doesn't read as a note Meld Encrypt wrote, or it comes from a version
      Slipdock doesn't know, so it can't be opened here.
    </p>

    <p class="mt-6 text-sm">
      <a href={@download} class="link">Download the file</a>
    </p>
  </div>
</Layouts.app>
